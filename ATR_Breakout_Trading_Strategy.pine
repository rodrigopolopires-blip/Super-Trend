//@version=6
strategy("ATR Breakout Trading - WIN B3", shorttitle="ATR Breakout", overlay=true, pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000)

// ========== INPUTS ==========
atrPeriod = input.int(14, "ATR Period", minval=1)
atrMult = input.float(2.0, "ATR Multiplier", minval=0.1)
volPeriod = input.int(20, "Volatility Period", minval=5)
trendPeriod = input.int(50, "Trend MA Period", minval=1)
tpPoints = input.int(200, "Take Profit Points", minval=1)
slPoints = input.int(200, "Stop Loss Points", minval=1)

// ========== CALCULATIONS ==========
atrVal = ta.atr(atrPeriod)
maClose = ta.sma(close, trendPeriod)
highVal = ta.highest(high, volPeriod)
lowVal = ta.lowest(low, volPeriod)
rangeVal = highVal - lowVal

// Volatility Status
isHighVol = rangeVal > ta.sma(rangeVal, volPeriod) * 1.2
isLowVol = rangeVal < ta.sma(rangeVal, volPeriod) * 0.8

// Trend Direction
isUpTrend = close > maClose
isDnTrend = close < maClose

// Breakout Levels
breakUpLevel = high + (atrVal * atrMult)
breakDnLevel = low - (atrVal * atrMult)

// Support & Resistance
resistance = ta.highest(high, 20)
support = ta.lowest(low, 20)

// ========== SIGNALS ==========
buySignal = close > breakUpLevel and isUpTrend
sellSignal = close < breakDnLevel and isDnTrend

// ========== STRATEGY ENTRIES & EXITS ==========
if buySignal
    strategy.entry("LONG", strategy.long)

if sellSignal
    strategy.entry("SHORT", strategy.short)

// Exit with TP and SL
strategy.exit("LONG_EXIT", "LONG", profit=tpPoints, loss=slPoints)
strategy.exit("SHORT_EXIT", "SHORT", profit=tpPoints, loss=slPoints)

// ========== ALERTS ==========
if buySignal
    alert("BUY SIGNAL - ATR Breakout UP", alert.freq_once_per_bar)
if sellSignal
    alert("SELL SIGNAL - ATR Breakout DOWN", alert.freq_once_per_bar)

// ========== VISUALIZATION ==========
// Breakout Lines
plot(breakUpLevel, "Breakout UP", color.new(color.red, 30), linewidth=2)
plot(breakDnLevel, "Breakout DOWN", color.new(color.blue, 30), linewidth=2)

// Support & Resistance
plot(resistance, "Resistance", color.new(color.red, 50), linewidth=1)
plot(support, "Support", color.new(color.green, 50), linewidth=1)

// Trend MA
plot(maClose, "Trend MA", color.new(color.gray, 40), linewidth=2)

// Volatility Background
volColor = isHighVol ? color.new(color.red, 92) : isLowVol ? color.new(color.green, 92) : color.new(color.gray, 95)
bgcolor(volColor)

// Entry Signals
plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="BUY", textcolor=color.white, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.small)